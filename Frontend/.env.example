# Copy to .env.local and fill in real values. Never commit .env.local.

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Database (Postgres / Supabase) ---
# Project Settings -> Database -> Connection string
# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
DATABASE_URL=""
# Direct connection (port 5432) — used by migrations.
DIRECT_URL=""
