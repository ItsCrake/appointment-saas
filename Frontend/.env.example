# Copy to .env.local and fill in real values. Never commit .env.local.

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Bypasses RLS — never expose to the client.
# Required for owner image uploads: it signs the upload URL the browser sends
# the file to. After setting it, run `npm run storage:setup` once per project.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Database (Postgres / Supabase) ---
# Project Settings -> Database -> Connection string
# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
DATABASE_URL=""
# Direct connection (port 5432) — used by migrations.
DIRECT_URL=""

# --- Notifications ---
# Every channel falls back to a console provider when its keys are missing:
# messages are logged, marked sent, and nothing leaves the machine. Add keys
# to switch a channel live — no code change needed.

# Protects /api/cron/notifications. REQUIRED for the cron route to run at all;
# without it the endpoint returns 401 rather than defaulting to open.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=""

# Email (Resend) — https://resend.com/api-keys
# Optional locally, REQUIRED in production: `check:env --production` fails
# without both, because an unconfigured email channel delivers nothing while
# still reporting every message as sent.
RESEND_API_KEY=""
# Must be a domain verified in Resend, e.g. "תורים <noreply@yourdomain.com>"
NOTIFICATIONS_FROM_EMAIL=""

# --- E2E tests (Playwright) ---
# Credentials for an existing, email-confirmed owner account. The dashboard
# specs skip cleanly when these are unset; the public booking specs still run.
E2E_EMAIL=""
E2E_PASSWORD=""

# SMS / WhatsApp (Twilio) — optional, not required for email notifications
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
# WhatsApp sender, e.g. "+14155238886" for the Twilio sandbox
TWILIO_WHATSAPP_FROM=""

# --- Platform console (/master) ---
# Comma-separated emails allowed into the super-admin console. Anyone listed
# can read every tenant's client list and impersonate any business, so keep it
# short. EMPTY OR UNSET DENIES EVERYONE — the console fails closed.
SUPER_ADMIN_EMAILS=""
