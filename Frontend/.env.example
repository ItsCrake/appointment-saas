# Copy to .env.local and fill in real values. Never commit .env.local.

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Bypasses RLS — never expose to the client.
# Required for owner image uploads: it signs the upload URL the browser sends
# the file to. After setting it, run `npm run storage:setup` once per project.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Database (Postgres / Supabase) ---
# Project Settings -> Database -> Connection string
# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
DATABASE_URL=""
# Direct connection (port 5432) — used by migrations.
DIRECT_URL=""

# --- Notifications ---
# Every channel falls back to a console provider when its keys are missing:
# messages are logged, marked sent, and nothing leaves the machine. Add keys
# to switch a channel live — no code change needed.

# Protects /api/cron/notifications. REQUIRED for the cron route to run at all;
# without it the endpoint returns 401 rather than defaulting to open.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=""

# Email (Resend) — https://resend.com/api-keys
# Optional locally, REQUIRED in production: `check:env --production` fails
# without both, because an unconfigured email channel delivers nothing while
# still reporting every message as sent.
RESEND_API_KEY=""
# Must be a domain verified in Resend, e.g. "תורים <noreply@yourdomain.com>"
NOTIFICATIONS_FROM_EMAIL=""

# --- E2E tests (Playwright) ---
# Credentials for an existing, email-confirmed owner account. The dashboard
# specs skip cleanly when these are unset; the public booking specs still run.
E2E_EMAIL=""
E2E_PASSWORD=""

# --- WhatsApp via the Meta Cloud API (preferred backend) ---
# The platform's own WhatsApp Business account, talking to Meta directly rather
# than through a reseller. Templates are addressed by *name*, so they are
# portable between deployments — unlike Twilio's per-account Content SIDs.
#
# Preferred over both other backends when set. Needs the three approved
# templates; a message kind with no approved template is refused rather than
# sent as free text, which Meta accepts and then silently drops.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Optional. Graph API version, defaults to v23.0. Set it when Meta retires that.
WHATSAPP_API_VERSION=""

# Cost guard. Stops every WhatsApp send *before* the HTTP call, so an internal
# test run cannot spend money. Messages are logged in full and the outbox row is
# marked `skipped` — never `sent`, so nothing reads as delivered.
#
# Fail-safe on purpose: any value other than false/0/no/off suppresses. A typo
# ("ture") therefore suppresses rather than starting to bill.
#
# `check:env --production` FAILS while this is set: WhatsApp is the only live
# client channel, so a deploy carrying it tells nobody anything while every
# screen still looks like it worked.
DISABLE_WHATSAPP_DISPATCH=""

# SMS / WhatsApp (Twilio) — optional, not required for email notifications
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
# WhatsApp sender, e.g. "+14155238886" for the Twilio sandbox
TWILIO_WHATSAPP_FROM=""

# Meta-approved WhatsApp templates, addressed by Twilio Content SID.
#
# Required only for the *official* Business API path. Meta drops a free-text
# business-initiated message after accepting it, so the Twilio WhatsApp provider
# refuses to send without the matching SID rather than losing it silently. Green
# API needs none of this — it drives the shop's own account.
#
# A SID is issued per Twilio account when a template is approved, so these
# differ between deployments of the same code. Look them up under
# Twilio Console → Messaging → Content Template Builder (they start "HX").
TWILIO_TEMPLATE_APPOINTMENT_CONFIRMATION=""
TWILIO_TEMPLATE_REMINDER_24H=""
TWILIO_TEMPLATE_REMINDER_2H=""

# --- WhatsApp via Green API (fallback backend) ---
# Drives the shop's own WhatsApp account rather than the official Business API,
# so a booking confirmation needs no Meta template approval. Ranks below the
# Meta Cloud credentials above and ahead of TWILIO_WHATSAPP_FROM. Leave blank to
# fall back to SMS/email.
GREEN_API_INSTANCE_ID=""
GREEN_API_TOKEN=""
# Optional. New instances are often issued on a numbered host, e.g.
# https://7103.api.greenapi.com
GREEN_API_HOST=""

# --- Web push (owner notifications) ---
# Generate the pair once with: npm run push:keys
# Rotating them invalidates every existing subscription — every owner who had
# enabled notifications would have to opt in again. Generate once, keep them.
#
# All three are needed together. Push is off with none of them and *refuses to
# configure* with some of them — a half-set trio is a deployment mistake, not a
# channel switched off, and `check:env` reports it as an error in every mode.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# RFC 8292 §2.1: a mailto: or https: URI a push service can use to reach you
# when a deployment misbehaves. Must be a real inbox — the value below is
# rejected outright precisely because it is the one most likely to be pasted
# unchanged.
VAPID_SUBJECT="mailto:you@yourdomain.com"

# --- Voice assistant ("ליבי") ---
# Claude API key. Powers Hebrew voice booking from the dashboard, for Pro-tier
# tenants only. Optional: with no key the microphone is not rendered at all and
# manual booking is unaffected — there is deliberately no fallback, because a
# fake parse would either invent an appointment or refuse every sentence.
# Speech-to-text is the browser's own Web Speech API and costs nothing; this key
# pays only for turning the transcript into structured fields.
ANTHROPIC_API_KEY=""

# --- Platform console (/master) ---
# Comma-separated emails allowed into the super-admin console. Anyone listed
# can read every tenant's client list and impersonate any business, so keep it
# short. EMPTY OR UNSET DENIES EVERYONE — the console fails closed.
SUPER_ADMIN_EMAILS=""
